---
title: Pardeh — Iranian Cinema & Theatre
---
<!doctype html>
<html lang="en" dir="ltr">
<script src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
<script>
  if (window.netlifyIdentity) {
    window.netlifyIdentity.on("init", user => {
      if (!user) {
        window.netlifyIdentity.on("login", () => {
          document.location.href = "/admin/";
        });
      }
    });
  }
</script>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }}</title>
  <meta name="description" content="Bilingual news and ticketing for Iranian cinema and theatre.">
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,wght@0,600;0,700;1,600&family=Work+Sans:wght@400;500;600;700&family=Vazirmatn:wght@400;500;600;700&display=swap">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

<header>
  <div class="brand">
    <span class="brand-word">{{ site.brand }}</span>
    <span class="brand-tag" data-en="{{ site.brand_tag_en }}" data-fa="{{ site.brand_tag_fa }}">{{ site.brand_tag_en }}</span>
  </div>
  <nav>
    <a class="navlink" href="#news" data-en="News" data-fa="اخبار">News</a>
    <a class="navlink" href="#shows" data-en="Shows" data-fa="برنامه‌ها">Shows</a>
    <a class="navlink" href="#about" data-en="About" data-fa="درباره ما">About</a>
    <a class="navlink" href="#contact" data-en="Contact" data-fa="تماس">Contact</a>
  </nav>
  <div class="header-actions">
    <button id="langToggle" type="button">فا</button>
    <a class="btn btn-primary" href="#shows" data-en="Buy Tickets" data-fa="خرید بلیت">Buy Tickets</a>
  </div>
</header>

<section class="hero">
  <div class="wrap hero-grid">
    <div>
      <span class="eyebrow" data-en="{{ site.hero_eyebrow_en }}" data-fa="{{ site.hero_eyebrow_fa }}">{{ site.hero_eyebrow_en }}</span>
      <h1 data-en="{{ site.hero_title_en }}" data-fa="{{ site.hero_title_fa }}">{{ site.hero_title_en | safe }}</h1>
      <p class="lede" data-en="{{ site.hero_lede_en }}" data-fa="{{ site.hero_lede_fa }}">{{ site.hero_lede_en }}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="#news" data-en="Read Latest News" data-fa="آخرین اخبار">Read Latest News</a>
        <a class="btn btn-outline" href="#shows" data-en="See Upcoming Shows" data-fa="برنامه‌های پیش‌رو">See Upcoming Shows</a>
      </div>
    </div>
    <div class="hero-card">
      <span class="kicker" data-en="{{ site.featured_kicker_en }}" data-fa="{{ site.featured_kicker_fa }}">{{ site.featured_kicker_en }}</span>
      <h3 data-en="{{ site.featured_title_en }}" data-fa="{{ site.featured_title_fa }}">{{ site.featured_title_en }}</h3>
      <span class="meta" data-en="{{ site.featured_meta_en }}" data-fa="{{ site.featured_meta_fa }}">{{ site.featured_meta_en }}</span>
    </div>
  </div>
</section>

<section id="news">
  <div class="wrap">
    <div class="section-head">
      <h2 data-en="Latest News" data-fa="آخرین اخبار">Latest News</h2>
      <a href="#" data-en="All news →" data-fa="همه اخبار ←">All news →</a>
    </div>
    <div class="news-grid">
      {% for item in collections.news %}
      {% set d = item.data %}
      <article class="card">
        <div class="card-art {% if d.category == 'theatre' %}theatre{% endif %}">
          {% if d.image %}
            <img src="{{ d.image }}" alt="">
          {% elif d.category == 'theatre' %}
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5"><path d="M4 20v-6a8 8 0 0 1 16 0v6"/><path d="M4 20h16"/><path d="M8 20v-5M16 20v-5"/></svg>
          {% else %}
            <svg viewBox="0 0 24 24" fill="none" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="2.4"/><circle cx="12" cy="4.5" r="1.1"/><circle cx="18.5" cy="8" r="1.1"/><circle cx="18.5" cy="16" r="1.1"/><circle cx="12" cy="19.5" r="1.1"/><circle cx="5.5" cy="16" r="1.1"/><circle cx="5.5" cy="8" r="1.1"/></svg>
          {% endif %}
        </div>
        <div class="card-body">
          <span class="tag {{ d.category }}" data-en="{{ d.category }}" data-fa="{% if d.category == 'theatre' %}تئاتر{% else %}سینما{% endif %}">{{ d.category | capitalize }}</span>
          <h3 data-en="{{ d.title_en }}" data-fa="{{ d.title_fa }}">{{ d.title_en }}</h3>
          <p class="excerpt" data-en="{{ d.excerpt_en }}" data-fa="{{ d.excerpt_fa }}">{{ d.excerpt_en }}</p>
          <div class="card-meta">
            <span data-en="{{ d.byline_en }}" data-fa="{{ d.byline_fa }}">{{ d.byline_en }}</span><span>·</span><span data-en="{{ d.read_time_en }}" data-fa="{{ d.read_time_fa }}">{{ d.read_time_en }}</span>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="shows">
  <div class="wrap">
    <div class="section-head">
      <h2 data-en="Upcoming Shows" data-fa="برنامه‌های پیش‌رو">Upcoming Shows</h2>
      <a href="#" data-en="Full schedule →" data-fa="برنامه کامل ←">Full schedule →</a>
    </div>
    <div class="shows-grid">
      {% for item in collections.shows %}
      {% set d = item.data %}
      <div class="show-card">
        <span class="tag {{ d.tag_type }}" data-en="{{ d.tag_en }}" data-fa="{{ d.tag_fa }}">{{ d.tag_en }}</span>
        <span class="show-date" data-en="{{ d.date_label_en }}" data-fa="{{ d.date_label_fa }}">{{ d.date_label_en }}</span>
        <h3 data-en="{{ d.title_en }}" data-fa="{{ d.title_fa }}">{{ d.title_en }}</h3>
        <span class="show-venue" data-en="{{ d.venue_en }}" data-fa="{{ d.venue_fa }}">{{ d.venue_en }}</span>
        <div class="ticket-row">
          <span class="meta" data-en="{{ d.price_label_en }}" data-fa="{{ d.price_label_fa }}">{{ d.price_label_en }}</span>
          <button class="ticket-btn" type="button" data-en="Get Tickets" data-fa="خرید بلیت">Get Tickets</button>
        </div>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="newsletter">
      <div>
        <h2 data-en="{{ site.newsletter_title_en }}" data-fa="{{ site.newsletter_title_fa }}">{{ site.newsletter_title_en }}</h2>
        <p style="margin-top:.5rem" data-en="{{ site.newsletter_sub_en }}" data-fa="{{ site.newsletter_sub_fa }}">{{ site.newsletter_sub_en }}</p>
      </div>
      <form onsubmit="return false;">
        <input type="email" data-en="you@example.com" data-fa="you@example.com" placeholder="you@example.com" required>
        <button class="btn btn-primary" type="submit" data-en="Subscribe" data-fa="عضویت">Subscribe</button>
        <span class="fineprint" data-en="Demo only — connect this to an email service later." data-fa="فقط نسخه نمایشی — بعداً به یک سرویس ایمیل متصل می‌شود.">Demo only — connect this to an email service later.</span>
      </form>
    </div>
  </div>
</section>

<section id="about">
  <div class="wrap about-grid">
    <div>
      <span class="eyebrow" data-en="{{ site.about_eyebrow_en }}" data-fa="{{ site.about_eyebrow_fa }}">{{ site.about_eyebrow_en }}</span>
      <h2 style="margin-bottom:1rem" data-en="{{ site.about_title_en }}" data-fa="{{ site.about_title_fa }}">{{ site.about_title_en }}</h2>
      <p data-en="{{ site.about_p1_en }}" data-fa="{{ site.about_p1_fa }}">{{ site.about_p1_en }}</p>
      <p data-en="{{ site.about_p2_en }}" data-fa="{{ site.about_p2_fa }}">{{ site.about_p2_en }}</p>
    </div>
    <div class="facts">
      {% for f in site.facts %}
      <div class="fact">
        <h3 data-en="{{ f.title_en }}" data-fa="{{ f.title_fa }}">{{ f.title_en }}</h3>
        <p data-en="{{ f.body_en }}" data-fa="{{ f.body_fa }}">{{ f.body_en }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

<footer id="contact">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <span class="brand-word" style="font-size:1.3rem">{{ site.brand }}</span>
        <p style="margin-top:.75rem; max-width:32ch" data-en="{{ site.footer_blurb_en }}" data-fa="{{ site.footer_blurb_fa }}">{{ site.footer_blurb_en }}</p>
        <div class="social-row">
          <a href="{{ site.social.telegram }}" aria-label="Telegram" title="Telegram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M21 4 3 11.5l6 2M21 4l-3.5 16-8.5-6.5M21 4 9 14.5v5"/></svg></a>
          <a href="{{ site.social.instagram }}" aria-label="Instagram" title="Instagram"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.4"/><circle cx="16.2" cy="7.8" r=".6" fill="currentColor" stroke="none"/></svg></a>
          <a href="{{ site.social.youtube }}" aria-label="YouTube" title="YouTube"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="6" width="18" height="12" rx="3"/><path d="M11 9.5l4 2.5-4 2.5z" fill="currentColor" stroke="none"/></svg></a>
        </div>
      </div>
      <div>
        <h4 data-en="Explore" data-fa="بخش‌ها">Explore</h4>
        <ul>
          <li><a href="#news" data-en="News" data-fa="اخبار">News</a></li>
          <li><a href="#shows" data-en="Shows" data-fa="برنامه‌ها">Shows</a></li>
          <li><a href="#about" data-en="About" data-fa="درباره ما">About</a></li>
        </ul>
      </div>
      <div>
        <h4 data-en="Sections" data-fa="موضوعات">Sections</h4>
        <ul>
          <li><a href="#" data-en="Cinema" data-fa="سینما">Cinema</a></li>
          <li><a href="#" data-en="Theatre" data-fa="تئاتر">Theatre</a></li>
          <li><a href="#" data-en="Interviews" data-fa="گفتگوها">Interviews</a></li>
        </ul>
      </div>
      <div>
        <h4 data-en="Contact" data-fa="تماس">Contact</h4>
        <ul>
          <li><a href="mailto:{{ site.contact_email }}">{{ site.contact_email }}</a></li>
          <li><a href="#" data-en="{{ site.contact_location_en }}" data-fa="{{ site.contact_location_fa }}">{{ site.contact_location_en }}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span data-en="{{ site.footer_note_en }}" data-fa="{{ site.footer_note_fa }}">{{ site.footer_note_en }}</span>
      <span data-en="Manage this site" data-fa="مدیریت سایت"><a href="/admin/" style="color:inherit">Manage this site →</a></span>
    </div>
  </div>
</footer>

<div id="toast" role="status"></div>

<script src="/js/main.js"></script>
</body>
</html>
